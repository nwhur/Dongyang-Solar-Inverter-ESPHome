# 이 파일을 복사하여 secrets.yaml 로 이름을 변경한 후 사용하세요.
# (secrets.yaml 파일은 .gitignore에 의해 깃허브 커밋에서 자동으로 제외됩니다.)

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# (선택) 보조 Wi-Fi 설정이 필요한 경우
wifi_ext_ssid: "YOUR_SECONDARY_WIFI_SSID"
wifi_ext_password: "YOUR_SECONDARY_WIFI_PASSWORD"

# ESPHome Fallback 핫스팟 접속 비밀번호 (8자 이상)
fallback_password: "MyFallbackPassword123!"
